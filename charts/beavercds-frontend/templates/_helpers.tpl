{{/*
Expand the name of the chart.
*/}}
{{- define "beavercds-frontend.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Create a default fully qualified app name.
We truncate at 63 chars because some Kubernetes name fields are limited to this (by the DNS naming spec).
If release name contains chart name it will be used as a full name.
*/}}
{{- define "beavercds-frontend.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Create chart name and version as used by the chart label.
*/}}
{{- define "beavercds-frontend.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Common labels
*/}}
{{- define "beavercds-frontend.labels" -}}
helm.sh/chart: {{ include "beavercds-frontend.chart" . }}
{{ include "beavercds-frontend.selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{/*
Selector labels
*/}}
{{- define "beavercds-frontend.selectorLabels" -}}
app.kubernetes.io/name: {{ include "beavercds-frontend.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/*
Create the name of the service account to use
*/}}
{{- define "beavercds-frontend.serviceAccountName" -}}
{{- if .Values.serviceAccount.create -}}
    {{ default (include "beavercds-frontend.fullname" .) .Values.serviceAccount.name }}
{{- else -}}
    {{ default "default" .Values.serviceAccount.name }}
{{- end -}}
{{- end -}}

{{/*
Name of the Secret containing database credentials. Either an external one from
the values, or our autogenerated one if there was not one provided.
*/}}
{{- define "beavercds-frontend.dbSecretName" -}}
{{- .Values.database.existingSecret | default (printf "%s-db-credentials" (include "beavercds-frontend.fullname" .)) }}
{{- end }}

{{/*
Name of the Secret containing application secrets (Django secret key,
CTFtime OAuth credentials). Either an external one from the values, or our
autogenerated one if there was not one provided.
*/}}
{{- define "beavercds-frontend.appSecretName" -}}
{{- .Values.appSecrets.existingSecret | default (printf "%s-app-secrets" (include "beavercds-frontend.fullname" .)) }}
{{- end }}

{{/*
Name of the Secret containing the frontend-api auth token. Either an external
one from the values, or our autogenerated one if there was not one provided.
*/}}
{{- define "beavercds-frontend.apiAuthTokenSecretName" -}}
{{- .Values.apiAuthToken.existingSecret | default (printf "%s-api-authtoken" (include "beavercds-frontend.fullname" .)) }}
{{- end }}

{{/*
envFrom fragment to load application secrets into a container.
*/}}
{{- define "beavercds-frontend.appEnvFrom" -}}
- secretRef:
    name: {{ include "beavercds-frontend.appSecretName" . | quote }}
- secretRef:
    name: {{ include "beavercds-frontend.apiAuthTokenSecretName" . | quote }}
{{- end }}

{{/*
Comma-separated list of allowed hostnames for the Django app, derived from the
Ingress and/or HTTPRoute hostnames (whichever are enabled).
*/}}
{{- define "beavercds-frontend.allowedHosts" -}}
{{- $hosts := list -}}
{{- if .Values.ingress.enabled -}}
{{- $hosts = concat $hosts .Values.ingress.hosts -}}
{{- end -}}
{{- if .Values.httpRoute.enabled -}}
{{- $hosts = concat $hosts .Values.httpRoute.hostnames -}}
{{- end -}}
{{- $hosts | uniq | join "," -}}
{{- end }}

{{/*
Pod envvar fragment for BCTF_ALLOWED_HOSTS. This is a static, non-secret value
derived from the ingress/httpRoute config, so it is passed as a plain env var
rather than through a Secret.
*/}}
{{- define "beavercds-frontend.allowedHostsEnv" -}}
- name: BCTF_ALLOWED_HOSTS
  value: {{ include "beavercds-frontend.allowedHosts" . | required "at least one of 'ingress.hosts' or 'httpRoute.hostnames' must be set (with the corresponding ingress/httpRoute enabled) to determine BCTF_ALLOWED_HOSTS!" | quote }}
{{- end }}

{{/*
Pod envvar fragment for database credentials. Sourced from the db-credentials
Secret per `dbSecretName` helper.
*/}}
{{- define "beavercds-frontend.dbEnv" -}}
- name: BCTF_DB_HOST
  valueFrom:
    secretKeyRef:
      name: {{ include "beavercds-frontend.dbSecretName" . | quote }}
      key: host
- name: BCTF_DB_PORT
  valueFrom:
    secretKeyRef:
      name: {{ include "beavercds-frontend.dbSecretName" . | quote }}
      key: port
- name: BCTF_DB_USERNAME
  valueFrom:
    secretKeyRef:
      name: {{ include "beavercds-frontend.dbSecretName" . | quote }}
      key: username
- name: BCTF_DB_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "beavercds-frontend.dbSecretName" . | quote }}
      key: password
- name: BCTF_DB_NAME
  valueFrom:
    secretKeyRef:
      name: {{ include "beavercds-frontend.dbSecretName" . | quote }}
      key: dbname
{{- end }}

{{/*
Common wait-for-db initcontainer
*/}}
{{- define "beavercds-frontend.initWaitForPostgres" -}}
name: wait-for-postgres
image: "{{ .Values.image.repository }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
imagePullPolicy: {{ .Values.image.pullPolicy }}

command: ["python3", "manage.py", "wait4db"]

envFrom:
  {{- include "beavercds-frontend.appEnvFrom" . | nindent 2 }}
  {{- with .Values.extraEnvFrom }}
  {{- toYaml . | nindent 2 }}
  {{- end }}

env:
  {{- include "beavercds-frontend.allowedHostsEnv" . | nindent 2 }}
  {{- include "beavercds-frontend.dbEnv" . | nindent 2 }}

{{- with $.Values.securityContext }}
securityContext:
  {{- toYaml . | nindent 2 }}
{{- end }}

volumeMounts:
  - name: django-settings
    mountPath: /app/bctf/helm_settings.py
    subPath: helm_settings.py
    readOnly: true
  {{- with .Values.volumeMounts }}
  {{- toYaml . | nindent 12 }}
  {{- end }}

{{- end }}
